 "lane": "new-build",
 "intent": {
  "audiences": [
   "공모전 투표자와 심사위원",
   "키오스크 앞에서 막히는 고령자와 정보를 빠르게 받아들이기 어려운 사람"
  ],
  "tasks": [
   "첫 화면에서 5초 안에 '키오스크가 어려운 사람이 QR로 내 방식 화면을 받는다'를 이해한다",
   "내 방식(큰 글씨, 쉬운 말, 큰 버튼)과 업종을 바꿔 변환 전후를 비교한다",
   "AI가 가격이나 메뉴를 바꿔도 확인 장치가 막는 것을 직접 눌러 본다"
  ],
  "qualities": [
   "첫 화면 제목이 누구의 어떤 어려움을 푸는지 말한다",
   "변환 전 키오스크와 변환 후 휴대폰이 함께 보인다",
   "키보드와 터치로 모두 쓸 수 있다",
   "개발자용 기록은 접어 두고 필요할 때만 펼친다"
  ],
  "constraints": [
   "정적 사이트이며 서버가 없다",
   "방문자 키는 메모리에만 둔다",
   "모든 데이터는 합성 값이다"
  ],
  "non_goals": [
   "실제 결제와 접수 연동",
   "장애 유형 추정이나 진단",
   "사용자 효과 측정"
  ]
 },
 "direction": {
  "name": "필드 노트와 픽셀 신호",
  "principles": [
   "작업 화면이 첫 화면이며 픽셀 그림은 작은 포인트로만 쓴다",
   "변환 전 키오스크는 작고 빽빽하게, 변환 후 휴대폰은 크고 한 가지씩 보인다",
   "금액과 원본 이름은 항상 같은 모양으로 보인다",
   "상태 변화는 모션 없이도 이해된다"
  ],
  "token_strategy": "create",
  "voice": "짧고 담백한 존댓말"
 },
